# Postgres connection string (Neon: use the "pooled" connection string)
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Optional: public origin used to build share URLs (otherwise derived from the request)
# PUBLIC_BASE_URL=https://your-app.vercel.app

# Set to 1 to let the x-test-now-ms header override "now" for expiry checks
TEST_MODE=0

PORT=3000
